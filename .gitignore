# Individual documents bind a person's machine and are the only tier that may
# carry secret references. They are never shared through this repository.
documents/**/individual/*.yaml
individual.yaml
# The copy scripts/migrate.sh keeps of a document it migrates. An Individual
# document's copy carries the same secret references, and does not end in .yaml.
*.contract-*.bak

# Planning and research artifacts stay local. This repository is public, and
# those documents carry internal program and system detail that the framework
# itself does not. They are the maintainer's working record, not a deliverable.
docs/plans/
docs/research/

# The maintainer's exact real-name screening list (tests/lib/real-name-patterns.txt
# holds the committed generic patterns).
tests/local/

# Secrets and per-machine state, never committed.
.env
.env.*
*.local

# OS / editor metadata
.DS_Store
Icon?
*.swp
.idea/
.vscode/

# Dependencies / build output
node_modules/

# --- Negations, last so they win ---

# The one shipped Individual document is fictional and is committed on purpose.
!documents/examples/individual/example-practitioner.yaml

# Nothing under tests/fixtures/ is ever ignored: a fixture named for a finding
# code must reach the validator exactly as written.
!tests/fixtures/
!tests/fixtures/**
